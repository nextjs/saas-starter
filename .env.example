# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# --- Notifikasi WhatsApp (Fase 2) ---
# Kosongkan untuk mode simulasi: pesan tetap dirender & dicatat di log,
# tapi tidak dikirim ke siapa pun.
WA_PROVIDER=simulasi
WA_TOKEN=
# Opsional, hanya untuk override endpoint saat testing:
# WA_BASE_URL=

# --- Penagihan langganan (Fase 3) ---
# Kosongkan untuk mode simulasi: tagihan tetap dibuat, tapi pelunasannya
# lewat halaman simulasi internal — tidak ada uang berpindah.
BILLING_PROVIDER=simulasi
# Xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Midtrans
MIDTRANS_SERVER_KEY=

# --- Email transaksional (Fase 4) ---
# Kosongkan untuk mode simulasi: isi email dirender & dicatat di email_log,
# tapi tidak dikirim ke siapa pun.
EMAIL_PROVIDER=simulasi
EMAIL_FROM="LaundryKu <noreply@domain-anda.com>"
# Resend
RESEND_API_KEY=
# atau SMTP (Zoho, Gmail, dsb.)
SMTP_URL=
